# --- Backend (FastAPI) ---
# Copiar a backend/.env. Tiene prioridad sobre el .env antiguo de la raíz.
APP_NAME=PsiTwin Inventory API
APP_VERSION=1.0.0

MONGODB_URL=mongodb://localhost:27017
MONGODB_DATABASE=psitwin_inventory

SECRET_KEY=change-me-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# Google OAuth Web application. Secret only on the backend; never VITE_GOOGLE_CLIENT_SECRET.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:5173/auth/google/callback
GOOGLE_OAUTH_TTL_SECONDS=600

EMAIL_ENABLED=false
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USE_TLS=true
SMTP_USER=psitwin2026@gmail.com
SMTP_APP_PASSWORD=
SMTP_FROM_NAME=PsiTwin Inventory
SMTP_PASSWORD=
SMTP_FROM=
EMAIL_VERIFICATION_TTL_MINUTES=10
EMAIL_VERIFICATION_COOLDOWN_SECONDS=60
EMAIL_VERIFICATION_MAX_ATTEMPTS=5
FRONTEND_URL=http://localhost:5173

CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen3:4b
OLLAMA_CONNECT_TIMEOUT_SECONDS=5
OLLAMA_READ_TIMEOUT_SECONDS=180
OLLAMA_NUM_THREADS=4
# For low-memory systems use 0s to unload Qwen after each response (slower next load).
OLLAMA_KEEP_ALIVE=5m
SAIKI_IDLE_TIMEOUT_SECONDS=10
SAIKI_DATABASE_TIMEOUT_SECONDS=10
SAIKI_REQUEST_TIMEOUT_SECONDS=360
SAIKI_MODEL_START_TIMEOUT_SECONDS=45
SAIKI_MODEL_MAX_TOKENS=512

# Local CPU speech; install requirements-voice.txt in a separate environment.
SAIKI_TTS_ENABLED=true
SAIKI_TTS_PROVIDER=kokoro
SAIKI_TTS_MODEL=hexgrad/Kokoro-82M
SAIKI_TTS_VOICE=em_santa
SAIKI_TTS_LANGUAGE=es
SAIKI_TTS_SPEED=1.0
SAIKI_VOICE_PYTHON=.voice.local/Scripts/python.exe
# Optional for a portable interpreter with packages in a separate directory.
SAIKI_VOICE_SITE_PACKAGES=
SAIKI_VOICE_TIMEOUT_SECONDS=120
SAIKI_STT_ENABLED=true
SAIKI_STT_MODEL=base
# Explicit local fallback only: provider=piper, install piper-tts, supply .onnx model.
SAIKI_PIPER_MODEL=

# Sensores (broker Mosquitto: backend/infra/mosquitto)
MQTT_ENABLED=true
SENSOR_DISCONNECT_SECONDS=5
SENSOR_MAX_READING_AGE_SECONDS=5
MQTT_HOST=localhost
MQTT_PORT=1883
MQTT_USER=psitwin-backend
MQTT_PASSWORD=backend-dev-123
