# Generar una clave aleatoria; usar la misma en Render. Nunca VITE_*.
AI_SERVICE_API_KEY=
AI_OLLAMA_LOCAL_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen3:4b-instruct
# EC2 siempre ejecuta el modelo local. No apuntar al propio servicio remoto.
AUTOGLUON_REMOTE_URL=
AUTOGLUON_PYTHON=/opt/psitwin/autogluon/bin/python
AUTOGLUON_ARTIFACT_DIR=/opt/psitwin/models/psitwin_forecasting
AUTOGLUON_CACHE_DIR=/opt/psitwin/cache
