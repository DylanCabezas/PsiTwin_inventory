# --- Frontend (Vite) ---
# Desarrollo: el frontend llama a /api/v1 y Vite lo reenvía a este backend (sin problemas de CORS).
VITE_PROXY_TARGET=http://localhost:8000

# Solo si quieres llamar al backend directamente (requiere CORS habilitado en el backend).
# Incluye /api/v1, sin barra final.
# VITE_API_URL=http://localhost:8000/api/v1

# --- Backend (FastAPI) ---
APP_NAME=PsiTwin Inventory API
APP_VERSION=1.0.0

MONGODB_URL=mongodb://localhost:27017
MONGODB_DATABASE=psitwin_inventory

